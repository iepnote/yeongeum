# KIS Developers 앱키 — 이 파일(.env.example)은 틀만 있는 견본입니다.
# 실제 값은 .env 파일에만 넣으세요 (.env는 .gitignore로 커밋에서 제외됨).
# 주의: VITE_ 접두사를 붙이지 마세요 — 붙이면 브라우저 번들에 포함되어 유출됩니다.
#       키는 M4.5 로컬 동기화 스크립트(Node)에서만 읽습니다.

KIS_APP_KEY=발급받은_앱키
KIS_APP_SECRET=발급받은_앱시크릿

# 계좌번호: 앞 8자리(종합계좌번호)와 뒤 2자리(상품코드)를 나눠 적습니다.
# 연금저축 상품코드 22, IRP 29
KIS_CANO=12345678
KIS_ACNT_PRDT_CD_PENSION=22
KIS_ACNT_PRDT_CD_IRP=29

# 연금저축이 IRP와 다른 종합계좌번호면 아래 줄의 #을 지우고 앞 8자리를 적으세요.
# KIS_CANO_PENSION=87654321

# 한투 앱키는 계좌 단위 발급 — 연금저축용 앱키를 따로 받았다면 아래 두 줄의 #을 지우고 입력하세요.
# KIS_APP_KEY_PENSION=연금저축_앱키
# KIS_APP_SECRET_PENSION=연금저축_앱시크릿
